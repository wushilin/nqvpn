[Unit]
Description=NetQ VPN coordinator
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nqvpn-coord run --config /etc/nqvpn/coordinator.toml
Restart=always
RestartSec=2
NoNewPrivileges=true
StateDirectory=nqvpn-coord
StateDirectoryMode=0700
# The database holds member secrets in the clear: nothing it writes is
# readable by other users.
UMask=0077

[Install]
WantedBy=multi-user.target
