[Unit]
Description=NetQ VPN forwarder (UDP, to one relay)
After=network-online.target
Wants=network-online.target

[Service]
# Point it at the relay's advertised address; clients then use
# --relay-via <relay-name>=<this-host>:44449.
ExecStart=/usr/local/bin/nqvpn-forward relay.example.com:4444 --bind 0.0.0.0:44449
Restart=always
RestartSec=2
# Copies datagrams and nothing else: no state, keys or privileges needed.
DynamicUser=true
NoNewPrivileges=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
