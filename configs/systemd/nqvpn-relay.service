[Unit]
Description=NetQ VPN relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nqvpn-relay --config /etc/nqvpn/relay.toml
Restart=always
RestartSec=2
# A member replaced by a newer join under the same name exits with 3 and
# must not be restarted blindly: it would only take the identity back.
# Everything else (crash, network loss; a disabled member keeps retrying
# on its own) is restarted.
RestartPreventExitStatus=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
StateDirectory=nqvpn-relay

[Install]
WantedBy=multi-user.target
